#!/bin/sh
# Commits to this repository must carry a Yenop identity and push over the project's SSH alias.
email="$(git config user.email || true)"
case "$email" in
  *@yenop.com) ;;
  *)
    echo "commit refused: set a Yenop identity for this repository first:" >&2
    echo "  git config --local user.email <you>@yenop.com" >&2
    exit 1 ;;
esac
remote="$(git remote get-url origin 2>/dev/null || true)"
case "$remote" in
  https://*|git@github.com:*)
    echo "origin must use the github-yenop SSH alias, not $remote" >&2
    exit 1 ;;
esac
