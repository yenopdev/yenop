{
  "name": "yenop",
  "version": "0.0.2",
  "description": "The layer between an AI agent and the systems it can touch: tool-call authorization, human approval, run budgets, receipts.",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "bin": {
    "yenop": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "npm run build",
    "pack:offline": "bash scripts/build-offline.sh"
  },
  "repository": {
    "type": "git",
    "url": "git@github-yenop:yenopdev/yenop.git"
  },
  "homepage": "https://yenop.com",
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.12.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "fast-check": "^4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "files": [
    "dist",
    "policies",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "ai-agents",
    "security",
    "authorization",
    "cedar",
    "mcp",
    "claude-code",
    "policy"
  ],
  "author": "Yenop <developer@yenop.com>"
}
