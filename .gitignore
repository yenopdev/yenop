# secrets and local state
.env
.env.*
*.pem
*.key
# yenop: config and policies are tracked; state and receipts are not
.yenop/state.db*
.yenop/receipts.jsonl
# language/tool caches
node_modules/
dist/
build/
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
target/
# claude code local settings (machine-specific hook path)
.claude/settings.local.json

# editors and OS
.DS_Store
.vscode/settings.json
.idea/


# built artifacts
yenop-offline-*.tgz
yenop-*.tgz
harness/breaches/

# benchmark: only the closed, published datasets are tracked. Earlier runs and runtime home copies stay local
# (hundreds of MB, and the homes hold third-party plugin files that are not ours to redistribute).
benchmark/results/*
!benchmark/results/2026-10-05-series5/
!benchmark/results/2026-10-05-series5-rerun/
benchmark/results/**/.codex-base-home/
